{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mason",
  "version": "0.1.0",
  "identifier": "cn.local.mason",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Mason",
        "width": 1280,
        "height": 800,
        "minWidth": 1100,
        "minHeight": 680,
        "resizable": true,
        "dragDropEnabled": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "resources": ["resources/python-env"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "PCB 钢网夹具生成器",
    "longDescription": "根据 PCB Gerber 文件自动生成 3D 打印的锡膏刷钢网定位夹具"
  }
}
